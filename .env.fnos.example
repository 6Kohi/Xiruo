# 复制为 .env.fnos，并在 fnOS Docker Compose 项目中使用。
XIRUO_PORT=3000
XIRUO_DATA_PATH=/vol1/1000/应用数据/Xiruo

# Docker Hub 无法拉取时可改为 public.ecr.aws/docker/library/node:22-bookworm-slim
XIRUO_NODE_IMAGE=node:22-bookworm-slim

# 使用容器内置网关时可以留空，启动时会自动生成内部密钥。
# 仅连接外部 XIRUO_SOURCE_GATEWAY 时需要填写与网关相同的至少 32 位密钥。
XIRUO_PROXY_SECRET=

# 网络可以直连来源时保持为空。
XIRUO_OUTBOUND_PROXY=
XIRUO_SOURCE_GATEWAY=

# hanime1 返回来源保护时，可填写浏览器同一出口下的 Cookie 与 User-Agent。
# Cookie 属于敏感信息，不要提交到 Git。
XIRUO_HANIME1_COOKIE=
XIRUO_HANIME1_USER_AGENT=
