# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xiruo_db
DB_USERNAME=xiruo_user
DB_PASSWORD=xiruo_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=myVerySecretJWTKey123456789
JWT_EXPIRATION=86400000

# Server Configuration
SERVER_PORT=8080
LOG_LEVEL=INFO
SHOW_SQL=false

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Mail Configuration (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB