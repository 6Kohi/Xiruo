# Reserved for the private deployment milestones.
# Never commit real source accounts, tokens, or cookies.
XIRUO_MASTER_KEY=
XIRUO_ADMIN_PASSWORD_HASH=
XIRUO_PROXY_SECRET=
XIRUO_ENABLE_REAL_SOURCES=false
# Optional for local/private deployments whose server needs an outbound proxy.
XIRUO_OUTBOUND_PROXY=
XIRUO_SOURCE_GATEWAY=
XIRUO_SOURCE_GATEWAY_PORT=4010
# Optional browser-approved hanime1 session. Treat the cookie as a secret.
XIRUO_HANIME1_COOKIE=
XIRUO_HANIME1_USER_AGENT=
XIRUO_CACHE_SERVICE=http://127.0.0.1:4011
XIRUO_CACHE_SERVICE_PORT=4011
XIRUO_DATA_DIR=./data
XIRUO_NHENTAI_SMOKE=false
XIRUO_HANIME1_SMOKE=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
