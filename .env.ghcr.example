# 当前仓库发布的完整镜像地址。
XIRUO_IMAGE=ghcr.io/6kohi/xiruo:latest
XIRUO_PORT=3100
XIRUO_DATA_PATH=/vol1/1000/docker/xiruo/data

# fnOS 可以直连来源时保持为空。
XIRUO_OUTBOUND_PROXY=
XIRUO_SOURCE_GATEWAY=

# 内置网关会自动生成内部密钥；只有外部网关才需要手动配置。
XIRUO_PROXY_SECRET=

# 可选：浏览器已通过 hanime1 验证时使用，Cookie 属于敏感信息。
XIRUO_HANIME1_COOKIE=
XIRUO_HANIME1_USER_AGENT=
